{
  "name": "emberfall",
  "productName": "Emberfall",
  "version": "1.4.2",
  "description": "Emberfall: Legends of the Shattered Crown \u2014 a 2D action RPG with online co-op",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.github.dddde6294.emberfall",
    "productName": "Emberfall",
    "files": [
      "main.js",
      "netmain.js",
      "preload.js",
      "web/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.role-playing-games"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Emberfall",
      "runAfterFinish": true,
      "artifactName": "Emberfall-Setup-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "electron-winstaller@5.4.0": true
  }
}
